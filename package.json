  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/product-shipping-os.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/product-shipping-os/issues"
  },
  "homepage": "https://github.com/your-username/product-shipping-os#readme"
}
